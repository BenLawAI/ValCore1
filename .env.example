# VALCORE1 Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ============================================================================
# Picovoice Wake Word Detection
# ============================================================================
# Get your free access key from: https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=YOUR_PICOVOICE_ACCESS_KEY_HERE

# ============================================================================
# Google Cloud MCP Integrations (Optional)
# ============================================================================

# Gmail MCP
# Instructions: See 04_Tools_Registry/gmail/README.md
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret

# Google Drive MCP
# Instructions: See 04_Tools_Registry/google_drive/README.md
GDRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your-client-secret

# Google Calendar MCP
# Instructions: See 04_Tools_Registry/calendar/README.md
GCAL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GCAL_CLIENT_SECRET=your-client-secret

# ============================================================================
# Web Search MCP (Optional)
# ============================================================================

# Google Custom Search (Optional - DuckDuckGo works without API key)
# Instructions: See 04_Tools_Registry/web_search/README.md
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_CX=your-custom-search-engine-id

# Bing Search API (Optional alternative)
BING_SEARCH_API_KEY=your-bing-api-key

# ============================================================================
# ATOM Server Configuration
# ============================================================================
# Usually no changes needed - these are defaults

# ATOM server IP address (from client's perspective)
ATOM_SERVER_IP=192.168.1.121

# ATOM server port (Ollama default)
ATOM_SERVER_PORT=11434

# Client Bridge port (Flask server on ATOM)
CLIENT_BRIDGE_PORT=5000

# ============================================================================
# Advanced Configuration (Optional)
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable development mode (more verbose logging, debugging features)
DEV_MODE=false

# GPU device overrides (usually auto-detected)
# VOICE_GPU_DEVICE=0
# FALLBACK_GPU_DEVICE=1

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Copy this file to .env in the same directory
# 2. Fill in your actual API keys and credentials
# 3. The .env file is automatically ignored by git
# 4. Never share your .env file or commit it to version control
#
# Required for basic functionality:
# - PICOVOICE_ACCESS_KEY (for wake word detection)
#
# Optional (system works without these):
# - Gmail, Drive, Calendar credentials (for MCP integrations)
# - Search API keys (DuckDuckGo works without keys)
# - ATOM server settings (defaults work for most setups)
#
