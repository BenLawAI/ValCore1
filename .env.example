# ==============================================================================
# VALCORE1 Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control!
#
# Usage:
#   1. Copy: cp .env.example .env
#   2. Edit .env with your actual API keys
#   3. The .env file is automatically ignored by git
# ==============================================================================

# ------------------------------------------------------------------------------
# PICOVOICE API KEY (Wake Word Detection)
# ------------------------------------------------------------------------------
# Get your API key from: https://console.picovoice.ai/
# Required for "Hey Val" wake word detection using Porcupine
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

# ------------------------------------------------------------------------------
# NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# ATOM Server IP (local network)
ATOM_LOCAL_IP=192.168.1.121

# ATOM Server IP (Tailscale VPN) - optional
ATOM_TAILSCALE_IP=

# Prefer Tailscale over local network (true/false)
PREFER_TAILSCALE=false

# ------------------------------------------------------------------------------
# API AUTHENTICATION (STRONGLY RECOMMENDED for security)
# ------------------------------------------------------------------------------
# Secure API key for Flask server authentication
# This protects your LLM endpoints from unauthorized access
#
# To generate a secure API key, run ONE of these commands:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
#   pwgen -s 32 1
#
# IMPORTANT: Use the SAME key on both client and server!
# - Set this in .env on BOTH machines (desktop and ATOM server)
# - The server will reject requests without a valid API key
# - If not set, server will run WITHOUT authentication (insecure!)
VALCORE_API_KEY=your_secure_api_key_here

# ------------------------------------------------------------------------------
# OPTIONAL: CUSTOM PATHS
# ------------------------------------------------------------------------------
# Custom library path (defaults to /home/user/ValCore1/Library)
# LIBRARY_PATH=/path/to/custom/library

# Custom log directory (defaults to ./logs)
# LOG_PATH=/path/to/custom/logs

# ------------------------------------------------------------------------------
# OPTIONAL: LLM CONFIGURATION
# ------------------------------------------------------------------------------
# Ollama server URL (defaults to http://localhost:11434)
# OLLAMA_BASE_URL=http://192.168.1.121:11434

# Default LLM model (defaults to qwen2.5:14b)
# DEFAULT_LLM_MODEL=qwen2.5:14b

# Fallback LLM model for client (defaults to qwen2.5:7b)
# FALLBACK_LLM_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# OPTIONAL: FLASK SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Flask server host (defaults to 0.0.0.0)
# FLASK_HOST=0.0.0.0

# Flask server port (defaults to 5000)
# FLASK_PORT=5000

# Flask debug mode (true/false, defaults to false)
# FLASK_DEBUG=false

# ------------------------------------------------------------------------------
# OPTIONAL: SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Enable HTTPS (true/false, defaults to false)
# ENABLE_HTTPS=false

# Path to SSL certificate (required if ENABLE_HTTPS=true)
# SSL_CERT_PATH=/path/to/cert.pem

# Path to SSL private key (required if ENABLE_HTTPS=true)
# SSL_KEY_PATH=/path/to/key.pem

# ------------------------------------------------------------------------------
# DEVELOPMENT & DEBUGGING
# ------------------------------------------------------------------------------
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Enable debug mode (true/false)
# DEBUG_MODE=false
