# VALCORE1 Environment Variables
# Copy this file to .env and configure for your environment

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Enable HTTPS/TLS (recommended for production)
VALCORE1_HTTPS=false

# API Key for authentication (optional, generates secure random key if not set)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VALCORE1_API_KEY=

# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Allowed CORS origins (comma-separated, use * for all)
# Example: http://localhost:3000,http://192.168.1.100:3000
ALLOWED_ORIGINS=*

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# SSL Certificate paths (if using custom certificates)
SSL_CERT_PATH=
SSL_KEY_PATH=

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# Ollama server URL (ATOM server)
OLLAMA_HOST=http://localhost:11434

# Default model
DEFAULT_MODEL=qwen2.5:14b

# LLM parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ============================================================================
# VOICE CONFIGURATION
# ============================================================================

# Picovoice access key for wake word detection
PICOVOICE_ACCESS_KEY=

# Speaker verification threshold
SPEAKER_VERIFICATION_THRESHOLD=0.7

# Audio device indices (run diagnostic scripts to find)
INPUT_DEVICE_INDEX=
OUTPUT_DEVICE_INDEX=

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# Library path for FAISS vector database
LIBRARY_PATH=/home/user/ValCore1/Library

# FAISS save frequency (seconds)
FAISS_SAVE_INTERVAL=300

# Backup configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60

# GPU temperature warning threshold (Celsius)
GPU_TEMP_WARNING=80
GPU_TEMP_CRITICAL=90

# Memory warning thresholds (GB)
RAM_WARNING_GB=2
VRAM_WARNING_GB=2

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/valcore1.log

# Log rotation
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# Tailscale hostname (for remote access)
TAILSCALE_HOSTNAME=

# Connection timeout (seconds)
CONNECTION_TIMEOUT=30

# Retry configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================

# Enable debug mode (NOT for production)
DEBUG=false

# Enable API documentation
ENABLE_API_DOCS=true

# Performance profiling
ENABLE_PROFILING=false
